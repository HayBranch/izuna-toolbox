{
  "name": "izuna-toolbox",
  "private": true,
  "version": "0.0.5",
  "description": "泉奈工具箱 —— 带 OBS 可捕获悬浮字幕的轻量 Tauri 桌面工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icon": "tauri icon scripts/app-icon.png",
    "bundle": "tauri build --bundles nsis",
    "bundle:portable": "tauri build --no-bundle && node scripts/package-portable.mjs",
    "portable": "node scripts/package-portable.mjs",
    "bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "tailwindcss": "^4",
    "typescript": "^5.6",
    "vite": "^7"
  }
}
